{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User learning profile, preferences, and active study state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Authenticated user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the learner.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "description": "Email address of the learner.",
          "minLength": 0,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL of the learner.",
          "minLength": 0,
          "maxLength": 1024
        },
        "activeMaterialId": {
          "type": "string",
          "description": "ID of the currently active study material.",
          "minLength": 0,
          "maxLength": 128
        },
        "themePreference": {
          "type": "string",
          "description": "UI theme preference.",
          "enum": ["light", "dark", "system"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last active timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "activeMaterialId",
        "themePreference",
        "createdAt",
        "lastActiveAt",
        "updatedAt"
      ]
    },
    "MaterialRecord": {
      "title": "MaterialRecord",
      "description": "Uploaded PDF, pasted text, or YouTube lecture study material owned by a specific user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceType": {
          "type": "string",
          "enum": ["pdf", "text", "youtube"],
          "maxLength": 16
        },
        "pageCount": {
          "type": "integer",
          "description": "Number of pages or segments (1 to 20)."
        },
        "iconColor": {
          "type": "string",
          "enum": ["red", "blue", "green", "yellow"],
          "maxLength": 16
        },
        "lastStudiedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "pagesData": {
          "type": "string",
          "description": "Serialized page-indexed or timestamp-indexed content.",
          "minLength": 2,
          "maxLength": 450000
        },
        "analysisData": {
          "type": "string",
          "description": "Serialized Gemini topic analysis and source metadata.",
          "minLength": 0,
          "maxLength": 150000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "sourceType",
        "pageCount",
        "iconColor",
        "lastStudiedAt",
        "pagesData",
        "analysisData",
        "createdAt",
        "updatedAt"
      ]
    },
