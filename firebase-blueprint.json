  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document owned strictly by {userId}."
    },
    "/users/{userId}/materials/{materialId}": {
      "schema": { "$ref": "#/entities/MaterialRecord" },
      "description": "Study materials owned strictly by {userId}."
    },
    "/users/{userId}/quizAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttemptRecord" },
      "description": "Completed quiz attempts owned strictly by {userId}."
    },
    "/users/{userId}/revisionPlans/{planId}": {
      "schema": { "$ref": "#/entities/RevisionPlanRecord" },
      "description": "Adaptive revision plans and Mistake DNA owned strictly by {userId}."
    },
    "/users/{userId}/flashcards/{deckId}": {
      "schema": { "$ref": "#/entities/FlashcardDeckRecord" },
      "description": "Active-recall flashcard decks owned strictly by {userId}."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/NoteRecord" },
      "description": "Sticky notes, mind maps, and revision sheets owned strictly by {userId}."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/ConversationRecord" },
      "description": "AI Study Tutor conversation histories owned strictly by {userId}."
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": { "$ref": "#/entities/ProgressRecord" },
      "description": "Per-material page and mastery progress owned strictly by {userId}."
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySessionRecord" },
      "description": "Completed focus study sessions owned strictly by {userId}."
    },
    "/users/{userId}/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttemptRecord" },
      "description": "Legacy quiz attempts subcollection preserved for migration."
    },
    "/users/{userId}/revisionStates/{stateId}": {
      "schema": { "$ref": "#/entities/RevisionStateRecord" },
      "description": "Legacy revisionStates subcollection preserved for migration."
    },
    "/users/{userId}/learningTools/{toolId}": {
      "schema": { "$ref": "#/entities/LearningToolsRecord" },
      "description": "Legacy learningTools subcollection preserved for migration."
    }
  }
}
